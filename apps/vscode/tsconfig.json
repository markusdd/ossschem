{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // the extension host loads CommonJS; the rest of the repo is ESM
    "module": "commonjs",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "types": ["node", "vscode"]
  },
  "include": ["src"]
}
